# Configuración de LLM para NASA ROSA
# Pega tu clave de Google Gemini (puedes obtener una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo de Gemini a usar (opcional, por defecto gemini-1.5-flash)
# Opciones recomendadas: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# (Alternativa opcional) Si prefieres OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
