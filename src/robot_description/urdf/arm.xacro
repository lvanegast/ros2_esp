<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parámetros del brazo sencillo -->
  <xacro:property name="arm_base_radius" value="0.04"/>
  <xacro:property name="arm_base_height" value="0.02"/>

  <xacro:property name="link1_radius" value="0.02"/>
  <xacro:property name="link1_length" value="0.08"/>

  <xacro:property name="link2_radius" value="0.018"/>
  <xacro:property name="link2_length" value="0.12"/>

  <xacro:property name="link3_radius" value="0.015"/>
  <xacro:property name="link3_length" value="0.10"/>

  <xacro:property name="wrist_radius" value="0.015"/>
  <xacro:property name="wrist_length" value="0.04"/>

  <!-- Base del brazo fijada al chasis -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.03 0.0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_base_radius}" length="${arm_base_height}"/>
      </geometry>
      <material name="arm_base_mat">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_base_radius}" length="${arm_base_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="${arm_base_radius}" h="${arm_base_height}"/>
  </link>

  <!-- Joint 1: Rotación de cintura (Yaw) -->
  <joint name="arm_joint_1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="arm_link_1">
    <visual>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="${link1_radius}" h="${link1_length}"/>
  </link>

  <!-- Joint 2: Hombro (Pitch) -->
  <joint name="arm_joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="15.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="arm_link_2">
    <visual>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>
      <material name="arm_accent">
        <color rgba="0.0 0.45 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="${link2_radius}" h="${link2_length}"/>
  </link>

  <!-- Joint 3: Codo (Pitch) -->
  <joint name="arm_joint_3" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi*0.75}" upper="${pi*0.75}" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="arm_link_3">
    <visual>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.15" r="${link3_radius}" h="${link3_length}"/>
  </link>

  <!-- Joint 4: Muñeca (Pitch) -->
  <joint name="arm_joint_4" type="revolute">
    <parent link="arm_link_3"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="5.0" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 ${wrist_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wrist_radius}" length="${wrist_length}"/>
      </geometry>
      <material name="arm_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wrist_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wrist_radius}" length="${wrist_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.08" r="${wrist_radius}" h="${wrist_length}"/>
  </link>

  <!-- Pinza / Gripper simple (1 DOF paralelo) -->
  <joint name="gripper_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.015 ${wrist_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="10.0" velocity="0.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 0.03"/>
      </geometry>
      <material name="gripper_mat">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.02" w="0.005" h="0.03" d="0.01"/>
  </link>

  <!-- Dedo derecho fijo (la pinza actúa cerrando el dedo izquierdo contra este) -->
  <joint name="gripper_right_finger_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.015 ${wrist_length}" rpy="0 0 0"/>
  </joint>

  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 0.03"/>
      </geometry>
      <material name="gripper_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.02" w="0.005" h="0.03" d="0.01"/>
  </link>

  <!-- Frame de efector final (TCP) para agarre e inferencia -->
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${wrist_length + 0.03}" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>

</robot>
