<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Propiedades geométricas de la base mecanum -->
  <xacro:property name="chassis_length" value="0.22"/>
  <xacro:property name="chassis_width" value="0.16"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass" value="2.5"/>

  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.032"/>
  <xacro:property name="wheel_mass" value="0.15"/>

  <xacro:property name="wheel_x_offset" value="0.0825"/> <!-- Media distancia entre ejes: l/2 -->
  <xacro:property name="wheel_y_offset" value="0.105"/>  <!-- Media distancia entre ruedas: w/2 -->
  <xacro:property name="wheel_z_offset" value="0.0"/>

  <!-- Macro inercial para cajas -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro inercial para cilindros -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Base footprint y Base link -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.15 0.20 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}"/>
  </link>

  <!-- Macro para ruedas mecanum -->
  <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.85 0.45 0.10 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * wheel_x_offset} ${y_reflect * wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>

  <!-- Instanciación de las 4 ruedas -->
  <xacro:mecanum_wheel prefix="front_left"  x_reflect="1"  y_reflect="1" />
  <xacro:mecanum_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:mecanum_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1" />
  <xacro:mecanum_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

</robot>
